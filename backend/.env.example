# Copy to .env for local development. Never commit or zip the real .env.
PORT=4001
# MongoDB Atlas connection string (a replica set: transactions are required).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parkease?retryWrites=true&w=majority
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
# IANA timezone of the parking network (e.g. Asia/Kolkata). Booking dates and hours are in this zone.
APP_TIMEZONE=UTC
# Used only by `npm run seed` to create or update the administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
